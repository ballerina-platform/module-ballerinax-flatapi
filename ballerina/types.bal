    string name?;
    # The section of the class
    @constraint:String {maxLength: 255}
    string section?;
};

# LTI 1.3 manual configuration creation
public type LtiConfigurationCreate1p3Manual record {
    # LTI 1.3 manual creation mode
    "1p3-manual" mode;
    # Enable email-based user matching during LTI authentication
    boolean enableEmailMatching?;
    # OAuth2 client_id allocated by the platform
    string clientId?;
    # Platform OIDC authorization endpoint URL
    string authorizationUrl?;
    # Platform JWKS endpoint URL for public keys
    string jwksUrl?;
    # Deployment identifier provided by the platform
    string deploymentId?;
    # Platform access token endpoint URL
    string accessTokenUrl?;
    # Platform issuer URL
    string platformIss?;
    # Platform display name
