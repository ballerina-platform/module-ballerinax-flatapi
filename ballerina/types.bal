# A pair of LTI 1.1 OAuth credentials
public type LtiCredentials record {
    # OAuth 1 Consumer Secret
    string consumerSecret?;
    # Unique identifier of the user who created these credentials
    string creator?;
    # Enable email-based user matching during LTI authentication.
    # 
    # When true (default): If a user with the same email exists in the organization,
    # they will be matched and logged in instead of creating a new account.
    # 
    # When false: Email matching is disabled. Only LTI ID matching is used, which means
    # multiple LTI users can share the same email address and have separate Flat accounts.
    # This is useful for cases like siblings sharing a parent email in the LMS
    boolean enableEmailMatching = true;
    # LMS name
    LmsName lms?;
    # The unique identifier of the Organization associated to these credentials
    string organization?;
    # Name of the pair of credentials
    string name?;
    # The last time these credentials were used
    string lastUsage?;
    # The unique identifier of this pair of credentials
    string id?;
    # The creation date of these credentials
    string creationDate?;
    # OAuth 1 Consumer Key
    string consumerKey?;
};

# Creation of an education resource
public type EduResourceCreation record {
    # Identifier of the parent resource where the new one will be created, e.g. a folder id or `root`
    string parent = "root";
    # Sharing description of the resource
    @constraint:String {maxLength: 400}
    string sharingDescription?;
    # Assignment-specific creation options.
    # Only applicable when creating a resource with `type: assignment`.
    # If `type` is not provided, defaults to `none`
    EduResourceAssignmentCreation 'resource?;
    # HTML version of sharing description with rich text formatting.
    # 
    # Supports safe HTML tags: p, br, strong, b, em, i, u, a
    @constraint:String {maxLength: 10000}
    string sharingDescriptionHtml?;
    # Type of an education resource
    EduResourceType 'type;
    # Title of the resource
    @constraint:String {maxLength: 1000, minLength: 1}
    string title;
};

# A Flat for Education Library
public type EduLibrary record {
    # Visibility of the library
    "private"|"organization"|"public" visibility;
    # Name of the library
    string name;
    # Unique identifier of the library.
    # 
    # This one can be used to list the underlying resources using
    # `GET /v2/eduResources?parent={library-id}`
    string id;
    # Type of the library
    "myResources"|"organizationResources"|"flatEduContent" 'type;
};

# LTI Link details for the class
public type EduResourceLtiLink record {
    # A URL that can be used to launch LTI with this resource in a classroom
    string ltiUrl;
};

# Represents the Queries record for the operation: listGroupUsers
public type ListGroupUsersQueries record {
    # Filter the users by their source
    "googleClassroom"|"microsoftGraph"|"clever" 'source?;
};

# If `canPublishInClass` and `canEdit` are false, the issue why this assignment cannot be published in a class
public type AssignmentCapabilitiesCanPublishInClassError record {
    # A corresponding code for this error
    string code;
    # A printable and localized message for this error
    string message;
};

# Type of the collection.
# The type will influence the capabilities available on the collections and how this collection is/can be populated.
# 
# - `root`: **Deprecated.** Previously the root collection of the user. The `allScores` virtual collection should be used instead.
# - `regular`: A regular collection created by the user. This collection can be deleted and modified by the user.
# - `app`: An automatically created collection containing the scores created by an app (e.g. Music Snippet)
# - `trash`: An automatically created collection containing the trashed scores.
# 
# Virtual collections:
# 
# - `allScores`: All the scores contained in the user account
# - `collaborations`: All shared scores by the user or someone else
# - `likes`: Liked scores
public type CollectionType "root"|"regular"|"app"|"trash"|"allScores"|"collaborations"|"likes";

# Represents the Headers record for the operation: getOmrCapabilities
public type GetOmrCapabilitiesHeaders record {
    # Preferred locale for localized content in the response (translated error messages, emails, etc.).
    # 
    # Accepts any IETF language tag. The API best-matches the value to a supported locale and never rejects an unknown one (it falls back to the closest match, then to `en`).
    # 
    # Supported normalized locales: `da`, `de`, `en`, `en-GB`, `es`, `fi`, `fil`, `fr`, `fr-CA`, `hi`, `id`, `it`, `ja`, `ko`, `ms`, `nl`, `nb`, `pl`, `pt`, `pt-BR`, `ro`, `ru`, `sv`, `tr`, `zh-Hans`, `zh-HK`, `zh-TW`.
    # 
    # Precedence (highest first): this `X-Flat-Locale` header, the authenticated user's account locale, the `Accept-Language` header, then `en`
    @http:Header {name: "X-Flat-Locale"}
    string xFlatLocale?;
};

# Represents the Queries record for the operation: updateScoreComment
public type UpdateScoreCommentQueries record {
    # This sharing key must be specified to access to a score or collection with a `privacy` mode set to `privateLink` and the current user is not a collaborator of the document
    string sharingKey?;
};

# Data-retention state of the job.
# 
# Present only on jobs whose `output` is `musicxml`. Jobs imported into the Flat library
# are part of your library content, are not covered by this policy, and omit this object
# entirely.
# 
# Erasure happens shortly after `expiryDate` rather than exactly on it. Plan for the
# deadline, not the instant
public type OmrJobRetention record {
    # When this job's uploaded files and recognition results become eligible for erasure.
    # Fixed when the job is created: changing the account's retention period does not move
    # the deadline of jobs that already exist
    string expiryDate;
    # When the job's stored files were actually erased. Present only once that happened.
    # 
    # An expired job keeps the `status` it finished with and stays listable, but its
    # `result` is no longer served and downloads fail with `OMR_JOB_EXPIRED`
    string expiredDate?;
};

# Represents the Headers record for the operation: deleteOmrJob
public type DeleteOmrJobHeaders record {
    # Preferred locale for localized content in the response (translated error messages, emails, etc.).
    # 
    # Accepts any IETF language tag. The API best-matches the value to a supported locale and never rejects an unknown one (it falls back to the closest match, then to `en`).
    # 
    # Supported normalized locales: `da`, `de`, `en`, `en-GB`, `es`, `fi`, `fil`, `fr`, `fr-CA`, `hi`, `id`, `it`, `ja`, `ko`, `ms`, `nl`, `nb`, `pl`, `pt`, `pt-BR`, `ro`, `ru`, `sv`, `tr`, `zh-Hans`, `zh-HK`, `zh-TW`.
    # 
    # Precedence (highest first): this `X-Flat-Locale` header, the authenticated user's account locale, the `Accept-Language` header, then `en`
    @http:Header {name: "X-Flat-Locale"}
    string xFlatLocale?;
};

public type LtiConfiguration1p1 record {
    *LtiConfigurationBase;
    # LTI version (1.1)
    "1p1" ltiVersion?;
    # LTI 1.1 consumer secret (only included for admins)
    string consumerSecret?;
    # LMS type
    string lms?;
    # Configuration name
    string name?;
    # LTI 1.1 consumer key
    string consumerKey?;
    # Platform/tool product information
    LtiConfiguration1p1_tool tool?;
};

# Represents the Queries record for the operation: deleteScoreFromCollection
public type DeleteScoreFromCollectionQueries record {
    # This sharing key must be specified to access to a score or collection with a `privacy` mode set to `privateLink` and the current user is not a collaborator of the document
    string sharingKey?;
    # Optional analytics properties merged into the analytics events recorded for this request.
    # 
    # JSON-encoded string representing event properties. Example:
    # 
    # - `?eventProperties={"context":"discover","screenLevel0":"home"}`
    string eventProperties?;
};

# Available scopes
public type AppScopes "account.public_profile"|"account.email"|"account.education_profile"|"scores.readonly"|"scores.social"|"scores"|"collections.readonly"|"collections.add_scores"|"collections"|"notifications.readonly"|"edu.resources"|"edu.resources.readonly"|"edu.classes"|"edu.classes.readonly"|"edu.assignments"|"edu.assignments.readonly"|"edu.admin"|"edu.admin.lti"|"edu.admin.lti.readonly"|"edu.admin.users"|"edu.admin.users.readonly"|"tasks.readonly"|"omr";

# LTI 1.3 configuration details
public type LtiConfiguration1p3 LtiConfiguration1p3Manual|LtiConfiguration1p3Deployment|LtiConfiguration1p3Dynamic;

# Clever.com section-related information
public type ClassDetailsClever record {
    # The last modification date of the section on clever
    string modificationDate?;
    # End date of the term
    string termEndDate?;
    # Normalized subject of the course
    "english/language arts"|"math"|"science"|"social studies"|"language"|"homeroom/advisory"|"interventions/online learning"|"technology and engineering"|"PE and health"|"arts and music"|"other" subject?;
    # Beginning date of the term
    string termStartDate?;
    # Clever section unique identifier
    string id?;
    # The creation date of the section on clever
    string creationDate?;
    # Name of the term when this course happens
    string termName?;
};

public type OmrJob record {
    # Metadata extracted from the recognized score
    OmrImportedMetadata importedMetadata?;
    # Localized, user-facing error message, present when `status` is `error`. Rendered in
    # the caller's locale and safe to display as-is. Pair with `errorCode` for branching
    string errorMessage?;
    # Stable, engine-agnostic failure code, present when `status` is `error`. Branch on
    # this for custom handling, and render `errorMessage` for the user-facing text.
    # 
    # This is an open string: new codes may be added over time, so keep a generic
    # fallback and never hardcode an exhaustive switch. Current values:
    # 
    # * `NO_MUSIC_DETECTED`: no musical content found (poor scan, rotated page, or tablature).
    # * `CORRUPTED_FILE`: the input file is corrupted and could not be read.
    # * `UNSUPPORTED_FORMAT`: the file format or notation is not supported yet.
    # * `UNSUPPORTED_TABLATURE`: the file is guitar tablature, not supported yet.
    # * `ENCRYPTED_PDF`: the PDF is password-protected.
    # * `TOO_LARGE`: the document is too large or has an unusual shape to process.
    # * `ENGINE_TIMEOUT`: recognition took longer than expected and was stopped.
    # * `GENERIC`: unspecified failure
    string errorCode?;
    # When the job was created
    string creationDate?;
    # Where the result of the job goes.
    # 
    # * `library`: import the result into the Flat Library and create a score (default).
    # * `musicxml`: finalize the result only, downloadable via `getOmrJobExport`. No score
    #   is created, for third-party integrations that do not use the Library
    OmrJobOutput output;
    # Steps this job pauses at for client input, echoing the value set at creation
    OmrStepName[] interactiveSteps;
    # The pending step when `status` is `awaitingInput`. Omitted otherwise
    OmrStepName currentStep?;
    # The outcome of a finished job. Present when `status` is `done`
    OmrJobResult result?;
    # Locale hints (BCP 47) the job was created with, used for OCR and as the default
    # main language at the `details` step
    string[] locales?;
    # When the job was last updated
    string modificationDate?;
    # Credits that will be or were charged at start (page-based), so a client can show a confirmation before charging
    int estimatedCredits?;
    # Metadata about the uploaded input
    OmrJobFileMetadata originalFileMetadata?;
    # The step currently awaiting client input. The `data` shape is keyed by `step`
    OmrPendingStep pendingStep?;
    # Live progress while the job is processing
    OmrJobProgress progress?;
    # Unique identifier of the OMR job
    string id;
    # Whether the job was created with `autoRotate`, echoing the value set at creation
    boolean autoRotate?;
    # Data-retention state of the job.
    # 
    # Present only on jobs whose `output` is `musicxml`. Jobs imported into the Flat library
    # are part of your library content, are not covered by this policy, and omit this object
    # entirely.
    # 
    # Erasure happens shortly after `expiryDate` rather than exactly on it. Plan for the
    # deadline, not the instant
    OmrJobRetention retention?;
    # Status of the job.
    # 
    # * `draft`: created, files can still be added; not yet started or charged.
    # * `processing`: the pipeline is running.
    # * `awaitingInput`: paused on the `currentStep`, waiting for the client to submit it.
    # * `done`: finished. See `result`.
    # * `error`: failed. See `errorCode`.
    # * `canceled`: canceled by the client
    OmrJobStatus status;
};

# A coursework on Google Classroom
public type GoogleClassroomCoursework record {
    # Identifier of the topic where the assignment is created
    string? topicId?;
    # Absolute link to this coursework in the Classroom web UI
    string alternateLink?;
