# Represents the Queries record for the operation: listOrganizationUsers
public type ListOrganizationUsersQueries record {
    # An opaque string cursor to fetch the next page of data.
    # The paginated API URLs are returned in the `Link` header when requesting the API. These URLs will contain a `next` and `previous` cursor based on the available data
    string next?;
    # The query to search
    string q?;
    # Filter users by role
    ("user"|"teacher"|"admin"|"accountAdmin")[] role?;
    # An opaque string cursor to fetch the previous page of data.
    # The paginated API URLs are returned in the `Link` header when requesting the API. These URLs will contain a `next` and `previous` cursor based on the available data
    string previous?;
    # Filter users by license expiration date or `active` / `notActive`
    string[] licenseExpirationDate?;
    # This is the maximum number of objects that may be returned
    @constraint:Int {minValue: 1, maxValue: 1000}
    int 'limit = 25;
    # Filter users based on test account status.
    # Test accounts are student accounts created for testing purposes by teachers.
    # 
    # * `exclude`: Hide test accounts from results.
    # * `only`: Show only test accounts.
    # 
    # When omitted, all users are returned
    "exclude"|"only" testAccounts?;
    # The order to sort the user list.
    # 
    # * `creationDate`: Order by account creation.
    # * `firstname`, `lastname`, `username`: Order by the user identity.
    # * `lastActivityDate`: Order by the last recorded activity.
    # * `licenseExpirationDate`: Order by the expiration of the active license
    "creationDate"|"firstname"|"lastname"|"username"|"lastActivityDate"|"licenseExpirationDate" sort?;
    # Return only user ids
    boolean onlyIds?;
    # Sort direction
    "asc"|"desc" direction?;
    # Filter users by group
    string[] group?;
    # Filter users who don't have an active license
    boolean noActiveLicense?;
};

