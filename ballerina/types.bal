};

# Status of the job.
# 
# * `draft`: created, files can still be added; not yet started or charged.
# * `processing`: the pipeline is running.
# * `awaitingInput`: paused on the `currentStep`, waiting for the client to submit it.
# * `done`: finished. See `result`.
# * `error`: failed. See `errorCode`.
# * `canceled`: canceled by the client
public type OmrJobStatus "draft"|"processing"|"awaitingInput"|"done"|"error"|"canceled";

# Live progress while the job is processing
public type OmrJobProgress record {
    # Localized progress message, ready to display
    string text?;
    # Completion percentage (0-100)
    decimal percent?;
    # Stable progress key (for example `OMR_QUEUED`, `OMR_PROCESSING_PAGE`,
    # `OMR_CREATING_SCORE`), for matching the current phase in a stepper UI
    # independent of locale
    string 'key?;
};

public type LtiConfiguration1p3Manual record {
    *LtiConfigurationBase;
    *LtiConfiguration1p3Base;
    # LTI version (1.3)
    "1p3" ltiVersion?;
    # Manual LTI 1.3 configuration mode
    "1p3-manual" mode?;
};

# Comment added on a sheet music
public type ScoreComment record {
    # The date when the comment was posted
    string date;
    # If the comment is marked as resolved, this will contain the unique identifier of the User who marked this comment as resolved
    string resolvedBy?;
    # The type of the comment
    "document"|"inline" 'type;
    # The unique identifier of the revision where the comment was posted
    string revision?;
    # The unique identifier of the score where the comment was posted
    string score;
    # The date of the last comment modification
    string modificationDate?;
    # The list of user identifiers mentioned in this comment
    string[] mentions?;
    # Information about the comment being moderated
    ScoreCommentModeration moderation?;
    # When the comment is a reply to another comment, the unique identifier of the parent comment
    string replyTo?;
    # The context of the comment (for inline/contextualized comments). A context will include all the information related to the location of the comment (i.e. score parts, range of measure, time position)
    ScoreCommentContext context?;
    # The comment text that can include mentions using the following
    # format: `@[id:username]`
    string comment;
    # The comment unique identifier
    string id;
    # A raw version of the comment, that can be displayed without parsing
    # the mentions
    string rawComment;
    # `true` if the message has been detected as spam and hidden from other users
    boolean spam?;
    # The author unique identifier
    string user;
    # For inline comments, the comment can be marked as resolved and will be hidden in the future responses
    boolean resolved?;
};

# Where the result of the job goes.
# 
# * `library`: import the result into the Flat Library and create a score (default).
# * `musicxml`: finalize the result only, downloadable via `getOmrJobExport`. No score
#   is created, for third-party integrations that do not use the Library
public type OmrJobOutput "library"|"musicxml";

