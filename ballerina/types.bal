    string format?;
    # Type of the task:
    # * `audio-export`: Exports a score to audio format (MP3, WAV)
    # * `score-save`: Saves or updates a score document
    # * `import-omr`: Processes a PDF through OMR (Optical Music Recognition) and imports it as a score
    string 'type?;
    # The creation date of the task
    string creationDate?;
    # The score revision identifier for tasks related to scores
    string revision?;
    # Optional result information about this task
    TaskResult result?;
    # The score unique identifier for tasks related to scores
    string score?;
    # The last modification date of the task
    string modificationDate?;
    # Child tasks for hierarchical task structures (e.g., conversion subtasks)
    Task[] children?;
    # Whether the task can be canceled by the user.
    # Only `true` when the task is in `created` state (waiting to be processed)
    boolean isCancellable?;
    # Details about the task progression
    TaskProgress progress?;
    # Unique identifier of the task
    string id;
    # State of the Task
    "created"|"blocked"|"doing"|"done"|"canceled"|"error" state;
    # The date when the task has been completed
    string doneDate?;
};

