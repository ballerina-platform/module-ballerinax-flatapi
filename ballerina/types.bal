public type ClassDetailsLti record {
    # If true, the class has been synchronized with the LTI 1.3 NRPS 2.0 service
    boolean hasNrpsService?;
    # Unique context identifier provided
    string contextId?;
    # Context title
    string contextTitle?;
    # Context label
    string contextLabel?;
};

# State of the submission history
public type AssignmentSubmissionHistoryState "created"|"turnedIn"|"returned"|"graded"|"reset";

# A computed version of the total, weekly, monthly, and yearly number of views of
# the score
public type ScoreViewsCounts record {
    # The total number of views of the score
    decimal total?;
    # The monthly number of views of the score
    decimal monthly?;
    # The yearly number of views of the score
    decimal yearly?;
    # The weekly number of views of the score
    decimal weekly?;
};

# LTI services support information
public type LtiConfiguration1p3BaseSupportedServices record {
    # Names and Role Provisioning Services support
    LtiConfiguration1p3BaseSupportedServicesNrps nrps?;
    # Deep Linking support
    LtiConfiguration1p3BaseSupportedServicesDeepLinking deepLinking?;
    # Assignment and Grade Services support
    LtiConfiguration1p3BaseSupportedServicesAgs ags?;
};

# Capabilities the current user has on this collection. Each capability corresponds to a fine-grained action that a user may take
public type CollectionCapabilities record {
    # Whether the current user can delete scores from the collection
    # 
    # If this collection has the `type` `trash`, this property will be set to `false`. Use `POST /v2/scores/{score}/untrash` to restore a score
    boolean canDeleteScores;
    # Whether the current user can add scores to the collection
    # 
    # If this collection has the `type` `trash`, this property will be set to `false`. Use `DELETE /v2/scores/{score}` to trash a score
    boolean canAddScores;
    # Whether the current user can modify the metadata for the collection
    boolean canEdit;
    # Whether the current user can modify the sharing settings for the collection
    boolean canShare;
    # Whether the current user can delete the collection
    boolean canDelete;
};

# Playback used by a student for an assignment submission
public type AssignmentSubmissionPlayback record {
    # The score unique identifier
    string score;
    # Number of times the score was played
    decimal nbPlayAttempt;
};

# Control the appearance of the score. If missing, default values are used.
public type ScoreCreationBuilderData_builderData_layoutData record {
    # A float value >= 1 that controls the spacing between notes.
    decimal notesSpacingCoeff?;
    # The right margin of the page in chosen unit (`lengthUnit`).
    decimal pageMarginRight?;
    # The top margin of the page in chosen unit (`lengthUnit`).
    decimal pageMarginTop?;
    # The unit to use for layout customizations
    "cm"|"inch" lengthUnit = "cm";
    # The bottom margin of the page in chosen unit (`lengthUnit`).
    decimal pageMarginBottom?;
    # The left margin of the page in chosen unit (`lengthUnit`).
    decimal pageMarginLeft?;
    # The height of the page in chosen unit (`lengthUnit`).
    decimal pageHeight?;
    # The width of the page in chosen unit (`lengthUnit`).
    decimal pageWidth?;
};

# Represents the Queries record for the operation: getScore
public type GetScoreQueries record {
    # This sharing key must be specified to access to a score or collection with a `privacy` mode set to `privateLink` and the current user is not a collaborator of the document
    string sharingKey?;
};

# Update of a classroom
public type ClassUpdate record {
    # Number of students in the classroom
    decimal? size?;
