# What the account or app can do, for client feature-detection
public type OmrCapabilities record {
    # Output destinations the account can use when creating a job
    OmrJobOutput[] outputs;
    # OMR credits remaining for the account
    int remainingCredits?;
    # Export formats available via `getOmrJobExport`
    string[] formats;
    # The same locales as `locales`, each with its English display name, sorted alphabetically
    # by `name` and ready to bind to a language picker.
    # 
    # Prefer this over `locales` when rendering a selector: it saves clients from shipping
    # their own code-to-label table
    OmrLocaleDetails[] localesDetails;
    # Filename extensions the accepted types appear under, for building a file picker.
    # 
    # Use these alongside `acceptedMimeTypes` in an `accept` attribute: browsers and native
    # file dialogs filter unreliably on some of the image types, so a valid file can be
    # greyed out when only its MIME type is offered.
    # 
    # Longer than `acceptedMimeTypes`, because one type arrives under several extensions
    # (`.jpg` and `.jpeg`, `.tif` and `.tiff`, `.heic` and `.heif`).
    # 
    # Picker metadata only. A file is identified by its content, so its extension never
    # decides whether an upload is accepted
    string[] acceptedExtensions;
    # Maximum size of a single file, in bytes
    int maxFileSize;
    # Interactive steps this server supports
    OmrStepName[] steps;
    # Locales selectable for OCR, as BCP 47 codes sorted alphabetically.
    # 
    # These are the locales the recognition pipeline can actually read, which is neither the
    # list of Flat interface locales nor a fixed set: new languages are added over time.
    # Clients should default to the user's own locale when it appears here
    string[] locales;
    # How many days a `musicxml` job's uploaded files and results are kept before erasure.
    # 
    # Reflects the account's own period when one has been set, otherwise the platform
    # default. Read-only: contact support to change it. Jobs with `output: library` are
    # not covered by the retention policy and are unaffected by this value
    int retentionDays?;
    # Maximum number of pages allowed across all input files of a single job
    int maxPages;
    # MIME types accepted for input files: PDF, plus the raster image formats.
    # 
    # Drive the file picker from this list rather than hardcoding it, so newly
    # supported formats need no client release. A file is identified by its content,
    # so its declared type and its extension do not have to match.
    # 
    # A multi-page input counts as several pages against `maxPages` and is charged
    # accordingly. That covers PDFs and, among the image formats, multi-page TIFF and
    # animated GIF/WebP
    string[] acceptedMimeTypes;
    # Credits charged per page
    int costPerPage?;
    # Maximum number of OMR jobs that can run in parallel for this account
    int maxParallelJobs;
    # Maximum number of input files that can be added to a single job
    int maxFiles;
};

# An OCR-selectable locale with its English name
public type OmrLocaleDetails record {
    # BCP 47 locale code. Always one of the codes listed in `locales`
    string code;
    # English name of the language, for display in a picker
    string name;
};

