# Collection of scores
public type Collection record {
    # For App collections, the details of the app that created the collection
    CollectionApp app?;
    # Capabilities the current user has on this collection. Each capability corresponds to a fine-grained action that a user may take
    CollectionCapabilities capabilities;
    # Whether the collection is pinned by the owner
    boolean isPinned?;
    # The url where the collection can be viewed in a web browser
    string htmlUrl;
    # The collection main privacy mode.
    # 
    # - `private`: The collection is private and can only be accessed, modified, and administered by specified collaborators
    CollectionPrivacy privacy;
    # The title of the collection
    string title;
    # Type of the collection.
    # The type will influence the capabilities available on the collections and how this collection is/can be populated.
    # 
    # - `root`: **Deprecated.** Previously the root collection of the user. The `allScores` virtual collection should be used instead.
    # - `regular`: A regular collection created by the user. This collection can be deleted and modified by the user.
    # - `app`: An automatically created collection containing the scores created by an app (e.g. Music Snippet)
    # - `trash`: An automatically created collection containing the trashed scores.
    # 
    # Virtual collections:
    # 
    # - `allScores`: All the scores contained in the user account
    # - `collaborations`: All shared scores by the user or someone else
    # - `likes`: Liked scores
    CollectionType 'type;
    # The date when the collection was created
    string creationDate;
    # The private sharing key of the collection (available when the `privacy` mode is set to `privateLink`)
    string sharingKey?;
    # The date when the collection was last modified
    string modificationDate?;
    # The contents of the collection
    CollectionContents contents;
    # The list of parent collections this score is included in. Please note that you might not have access to all of them
    string[] collections?;
    # If the score has been created in an organization, the identifier of this organization. 
    string organization?;
    # The rights of the current user on a score or collection
    ResourceRights rights?;
    # The list of the collaborators of the collection
    ResourceCollaborator[] collaborators?;
    # Unique identifier of the collection
    string id;
    # Product-specific translation key for the collection type.
    # 
    # Only set for specific collection types:
    # * For `regular` type: `playlist` (Flat) or `collection` (Flat for Education)
    # * For `collaborations` type: `collaboration` (Flat) or `shared-scores` (Flat for Education)
    # 
    # Not set for other collection types
    string labelKey?;
    # Public User details summary
    UserPublicSummary user?;
};

