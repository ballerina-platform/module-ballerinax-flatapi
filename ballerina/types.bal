};

# The sharing mode of the score for classes post and assignments
public type MediaScoreSharingMode "read"|"write"|"copy"|"performance";

# Assignment Submission
public type AssignmentSubmission record {
    # If set, this submission has a linked LTI 1.3 AGS or LTI 1.1 Outcomes
    AssignmentSubmissionLti lti?;
    # The User identifier of the student who created the submission
    string creator;
    # The attachments of the submission
    MediaAttachment[] attachments;
    # The feedback comments counters of the submission
    AssignmentSubmissionComments comments;
    # Unique identifier of the assignment
    string assignment;
    # A coursework submission on Google Classroom
    GoogleClassroomSubmission googleClassroom?;
    # Unique identifier of the classroom where the assignment was posted
    string classroom;
    # The date when the student submitted their work
    string submissionDate?;
    # The date when the submission was created
    string creationDate;
    # Optional grade. If unset, no grade was set. This value is only visible to the teacher, and is copied to `grade` once the teacher returns the submission
    decimal? draftGrade?;
    # The date when the teacher returned the work
    string returnDate?;
    # Optional max points for the grade. If set, a corresponding `draftGrade` or `grade` will be set
    decimal maxPoints?;
    # Optional grade. If unset, no grade was set
    decimal? grade?;
    # The playback statistics of the submission scores
    AssignmentSubmissionPlayback[] playback;
    # Unique identifier of the submission
    string id;
    # State of the submission
    AssignmentSubmissionState state;
    # The Microsoft Graph submission linked to this submission
    MicrosoftGraphSubmission microsoftGraph?;
    # The ids of exercises when they need to be in a specific order
    string[] exercisesIds?;
    # The User unique identifier of the teacher who returned the submission
    string returnCreator?;
};

# Request to create a new LTI configuration (unified 1.1 and 1.3)
public type LtiConfigurationCreate LtiConfigurationCreate1p1|LtiConfigurationCreate1p3Dynamic|LtiConfigurationCreate1p3Deployment|LtiConfigurationCreate1p3Manual;

public type LtiConfigurationBase record {
    # LTI version
    "1p1"|"1p3" ltiVersion;
