# One image or PDF added to a draft job
public type OmrJobFileUpload record {
    # File data, base64-encoded. The type is read from the content itself, so no
    # declared MIME type or filename extension is needed. Accepted types are listed by
    # `getOmrCapabilities` in `acceptedMimeTypes`
    string file;
    # Optional original filename, kept for display
    string filename?;
};

public type ScoreCreationBuilderData_builderData record {
    # Control the appearance of the score. If missing, default values are used.
    ScoreCreationBuilderData_builderData_layoutData layoutData?;
    ScoreCreationBuilderData_builderData_scoreData scoreData;
};

# The context of the comment (for inline/contextualized comments). A context will include all the information related to the location of the comment (i.e. score parts, range of measure, time position)
public type ScoreCommentContext record {
    # (Deprecated, use `staffUuid`) The identifier of the staff
    # 
    # # Deprecated
    @deprecated
    decimal staffIdx?;
    # The list of measure UUIDs
    string[] measureUuids;
    # The unique identifier (UUID) of the score part
    string partUuid;
    # The unique identifier (UUID) of the staff
    string staffUuid?;
    # The division per quarter note where the commented range stops
    decimal stopDpq;
    # The time position where the commented range starts
    decimal startTimePos;
    # The time position where the commented range stops
    decimal stopTimePos;
    # The division per quarter note where the commented range starts
    decimal startDpq;
};

