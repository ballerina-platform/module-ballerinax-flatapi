# Assignment details
public type Assignment record {
    # The id of the associated toolset
    string toolset?;
    # Reference material handed to the students with the assignment: scores, videos, links and
    # Drive files. A score attached here is the one each student receives their own copy of
    MediaAttachment[] attachments;
    # HTML version of teacher-only instructions with rich text formatting.
    # Supports the following HTML tags: p, br, strong, b, em, i, u, a, ul, ol, li, h1, h2, h3, img.
    # Images are served as absolute http(s) URLs
    string teacherInstructionsHtml?;
    # Student instructions and content of the assignment (plain text)
    string description?;
    # For worksheets, how grading will work for the assignment:
    # - If set to `auto`, the grades will be automatically released when the student submits the submissions
    # - If set to `manual`, the grades will only be set as `draftGrade` and will be released when the teacher returns the submissions
    "auto"|"manual" releaseGrades?;
    # Restrict the ability to get an audio feedback every time a student adds or selects a note
    boolean restrictPlayNote?;
    # Type of the assignment
    AssignmentType 'type;
    # Title of the assignment
    string title;
    # For performance assignments: "Free Record" mode.
    # 
    # When `true`, no score is attached to the assignment. Students freely record a varied
    # repertoire or an ensemble performance without being constrained by a single score's
    # structure or duration, and all score-dependent options (playback, metronome, backtracking,
    # speed control) are hidden.
    # 
    # Only set when type is 'performance'
    boolean freeRecord?;
    # For performance assignments: Enable students to use the metronome while they are recording,
    # helping them stay in time.
    # Only set when type is 'performance'
    boolean allowMetronome?;
    # The URL of the cover to display
    string cover?;
    # Teacher-only instructions for this assignment.
    # These instructions are only visible to teachers and are not returned when students view the assignment.
    # If `teacherInstructionsHtml` is provided, this field will contain the plain text version for compatibility
    string teacherInstructions?;
    # If set, the grading will be enabled for the assignment
    decimal maxPoints?;
    # For performance assignments: recording type that will be either 'audio' or 'video'.
    # 
    # * `audio`: Only audio will be required during the recording.
    # * `video`: Camera will be required during the recording.
    # 
    # Only set when type is 'performance'
    "audio"|"video" recordingType?;
    # Submission mode for assignments:
    # - "single": Individual submissions (default)
    # - "group": Group submissions (for shared writing assignments)
    AssignmentSubmissionStudentsMode submissionStudentsMode?;
    # The number of playbacks authorized on the scores of the assignment
    decimal nbPlaybackAuthorized?;
    # Unique identifier of the assignment
    string id;
    # For all assignments created after 02/2023, all the underlying resources must be dedicated and stored in the assignment.
    # This boolean indicates that this assignment only supports dedicated attachments
    boolean useDedicatedAttachments?;
    # Shuffle the worksheet exercises for each student
    boolean shuffleExercises?;
    # For performance assignments: whether students can adjust the playback speed of the score during recording.
    # 
    # * `true`: Students can change the tempo/speed during practice and recording
    # * `false`: Tempo is fixed to the original score tempo
    # 
    # Only set when type is 'performance'
    boolean allowSpeedChange?;
    # Capabilities the current user has on this assignment. Each capability corresponds to a fine-grained action that a user may take
    AssignmentCapabilities capabilities;
    # The id of the cover to display
    string coverFile?;
    # Restrict the audio source to provided audio tracks on a score. Students won't be able to use the editor playback
    boolean restrictToAudioTracks?;
    # For performance assignments: Enable students to listen to the accompaniment without their
    # instrument part while they are playing.
    # Only set when type is 'performance'
    boolean allowBackingTrack?;
    # HTML version of student instructions with rich text formatting.
    # Supports the following HTML tags: p, br, strong, b, em, i, u, a, ul, ol, li, h1, h2, h3, img.
    # Images are served as absolute http(s) URLs
    string descriptionHtml?;
};

