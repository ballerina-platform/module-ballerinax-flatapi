public type UserSigninLinkCreation record {
    # Path to redirect to after signin
    string destinationPath = "/";
};

# The score main privacy mode.
# 
# - `public`: The score is public on the Internet. This one can be accessible at the url `https://flat.io/score/{score}` and can be modified and administered by specified collaborators users.
# - `private`: The score is private and can be only accessed, modified and administered by specified collaborators users.
# - `privateLink`: The score is private but can be accessed using a private link `htmlUrl` or the private key in the property `sharingKey`.
# - `organizationPublic`: _Available only with [Flat for Education](https://flat.io/edu)._ The score is public in the organization: users of the same organization can access it. The score can be modified and administered by specified collaborators users.
# 
# The score can also be individually shared to a set of users or groups using the different collaborators API methods.
# 
# When a file is synchronized from an external source (e.g. Google Drive) and the sharing options are changed on the source, Flat will choose the best privacy mode for the file.
# 
# When using a [Flat for Education](https://flat.io/edu) account, some of the modes may not be available if disabled by an administrator of the organization (e.g. by default the `public` mode is not available)
public type ScorePrivacy "public"|"private"|"organizationPublic"|"privateLink";

# Represents the Queries record for the operation: markScoreCommentUnresolved
public type MarkScoreCommentUnresolvedQueries record {
    # This sharing key must be specified to access to a score or collection with a `privacy` mode set to `privateLink` and the current user is not a collaborator of the document
    string sharingKey?;
};

# The type of creation (an original, an arrangement)
public type ScoreCreationType "original"|"arrangement"|"other"?;

public type ScoreCreationBuilderData_builderData_scoreData_instruments record {
    # The identifier of the instrument (e.g. `piano`, `trumpet`)
    string instrument;
    # The abbreviation of the name of the instrument
    string shortName?;
    # True if the part can use quarter tones (prevents the part from having a TAB staff or chord grid)
    boolean hasQuarterTone?;
    # The identifier of the instrument group (e.g. `keyboards`, `brass`)
    string group;
    # The full name of the instrument
    string longName?;
};

# Specific skills that will be focused in classroom
public type EduSkillsFocused ("notation"|"sight-reading"|"performance-instrumental"|"ear-training"|"music-theory"|"composition"|"jazz-ensemble"|"music-technology"|"other")[];

# Override for a single detected part, matched by `index`. Omitted fields keep the
# detected value.
# 
# To set the instrument you may use **either** `instrumentId` (Flat's instrument id)
# **or** `midiProgram` (a standard General MIDI program) — whichever your integration
# prefers; you do not need both. If both are sent, `instrumentId` wins; otherwise
# `midiProgram` is resolved to the matching instrument; otherwise the detected
# instrument is kept. `transposeKey` and `partName` apply independently on top
public type OmrInstrumentOverride record {|
    # Override the resolved instrument with this Flat instrument id, for example
    # `brass.horn`. See the [Instrument IDs reference](https://flat.io/developers/docs/api/instruments)
    # for valid values. Both the dotted `<group>.<instrument>` form (`brass.horn`) and the bare
    # instrument key (`horn`) are accepted. Use this or `midiProgram`. Takes precedence over
    # `midiProgram` when both are set
    @constraint:String {maxLength: 100, minLength: 1}
    string instrumentId?;
    # Override the transposition / written key: a pitch class as a letter `A`-`G` with an
    # optional accidental. For example `F` for Horn in F or `Bb` for a B flat clarinet.
    # 
    # The accidental may be ASCII `b` (flat) or `#` (sharp), or the Unicode music glyphs
    # `♭` (U+266D) and `♯` (U+266F). Unicode accidentals are normalized to their ASCII
    # equivalent, so `B♭` is stored and returned as `Bb`
    @constraint:String {pattern: re `^[A-G][b♭#♯]?$`}
    string transposeKey?;
    # 0-based position of the part to override, matching the `index` of the detected part
    @constraint:Int {minValue: 0}
    int index;
    # Override the part name
    @constraint:String {maxLength: 200}
    string partName?;
    # Override the instrument with a standard General MIDI program number (0-127),
    # resolved server-side to the matching Flat instrument. Use this when you do not want
    # to map Flat instrument ids. Ignored if `instrumentId` is also set
    @constraint:Int {minValue: 0, maxValue: 127}
    int midiProgram?;
|};

# The grades of this resource, or the grades of the resources included in the folder
public type EduResourceGrades Grade[];

# LTI configuration details (unified 1.1 and 1.3)
public type LtiConfiguration LtiConfiguration1p1|LtiConfiguration1p3;

# The details of a group
public type GroupDetails record {
    # The unique identifier of the parent class group. Only available for groups of type 'assignmentStudentsSubGroup'. May be null if the parent class group was deleted
    string parent?;
    # The unique identifier of the assignment owning the group. Only available for groups of type 'assignmentStudentsSubGroup'
    string assignment?;
    # The unique identifier of the Organization owning the group
    string organization?;
    # The displayable name of the group
    string name;
    # The unique identifier of the classroom owning the group. Only available for groups of type 'classStudentsSubGroup' or 'assignmentStudentsSubGroup'
    string classroom?;
    # The number of students in this group
    decimal usersCount;
    # `true` if the properties and members of this group are read-only
    boolean readOnly;
    # The unique identifier of the group
    string id;
    # The type of the group:
    # * `generic`: A group created by a Flat user
    # * `classTeachers`: A group created automatically by Flat that contains
    #   the teachers of a class
    # * `classStudents`: A group created automatically by Flat that contains
    #   the students of a class
    # * `classStudentsSubGroup`: Manually created sub-group of students of a class. 
    # * `assignmentStudentsSubGroup`: Manually created Sub-group of students of a class, in relation to a specific assignment
    GroupType 'type;
    # The date when the group was created
    string creationDate;
    # Tags for categorizing groups.
    # 
    # * `edu:testing-students`: Marks this group as containing test student accounts
    string[] tags;
};

public type UserSigninLink record {
    # URL to use to sign in to this account
    string url?;
    # Raw sign-in token, can be used to build custom URLs (e.g. deep links)
    string token?;
    # Date when the link expires
    string expirationDate?;
};

# Represents the Queries record for the operation: listBillingCreditsHistory
public type ListBillingCreditsHistoryQueries record {
    # An opaque string cursor to fetch the next page of data.
    # The paginated API URLs are returned in the `Link` header when requesting the API. These URLs will contain a `next` and `previous` cursor based on the available data
    string next?;
    # An opaque string cursor to fetch the previous page of data.
    # The paginated API URLs are returned in the `Link` header when requesting the API. These URLs will contain a `next` and `previous` cursor based on the available data
    string previous?;
    # This is the maximum number of objects that may be returned
    @constraint:Int {minValue: 1, maxValue: 1000}
    int 'limit = 50;
};

# The type of the group:
# * `generic`: A group created by a Flat user
# * `classTeachers`: A group created automatically by Flat that contains
#   the teachers of a class
# * `classStudents`: A group created automatically by Flat that contains
#   the students of a class
# * `classStudentsSubGroup`: Manually created sub-group of students of a class. 
# * `assignmentStudentsSubGroup`: Manually created Sub-group of students of a class, in relation to a specific assignment
public type GroupType "generic"|"classTeachers"|"classStudents"|"classStudentsSubGroup"|"assignmentStudentsSubGroup";

# License of the creation. Read more about the Creative Commons licenses on https://creativecommons.org/licenses/
public type ScoreLicense "copyright"|"cc0"|"cc-by"|"cc-by-sa"|"cc-by-nd"|"cc-by-nc"|"cc-by-nc-sa"|"cc-by-nc-nd"?;

# A single image or PDF input, base64-encoded
public type OmrJobInputFile record {
    # File data, base64-encoded. The type is read from the content itself, so no
    # declared MIME type or filename extension is needed. Accepted types are listed by
    # `getOmrCapabilities` in `acceptedMimeTypes`
    string file;
    # Optional original filename, kept for display
    string filename?;
};

# A score revision metadata
public type ScoreRevision record {
    # The date when this revision was created
    string date;
    # The score identifier
    string score;
    # True if this revision was automatically generated by Flat and not on
    # purpose by the user
    boolean autosave?;
    # The user identifiers of the collaborators of the revision
    string[] collaborators?;
    # A description associated to the revision
    string description?;
    # The unique identifier of the revision
    string id;
    # The last event (action id) of the revision
    string event?;
    # The user identifier who created the revision
    string user?;
    # The statistics related to the score revision (additions and deletions)
    ScoreRevisionStatistics statistics?;
};

public type ScoreCreationCommon record {
    # If the user uses Google Drive and this property is specified, the file will be created in this directory. The user creating the file must have write access to this directory
    string googleDriveFolder?;
    # The score main privacy mode.
    # 
    # - `public`: The score is public on the Internet. This one can be accessible at the url `https://flat.io/score/{score}` and can be modified and administered by specified collaborators users.
    # - `private`: The score is private and can be only accessed, modified and administered by specified collaborators users.
    # - `privateLink`: The score is private but can be accessed using a private link `htmlUrl` or the private key in the property `sharingKey`.
    # - `organizationPublic`: _Available only with [Flat for Education](https://flat.io/edu)._ The score is public in the organization: users of the same organization can access it. The score can be modified and administered by specified collaborators users.
    # 
    # The score can also be individually shared to a set of users or groups using the different collaborators API methods.
    # 
    # When a file is synchronized from an external source (e.g. Google Drive) and the sharing options are changed on the source, Flat will choose the best privacy mode for the file.
    # 
    # When using a [Flat for Education](https://flat.io/edu) account, some of the modes may not be available if disabled by an administrator of the organization (e.g. by default the `public` mode is not available)
    ScorePrivacy privacy?;
    # Unique identifier of a collection where the score will be created.
    # If no collection identifier is provided, the score will not be added to any collection and will only be visible in the `allScores` virtual collection
    string collection?;
    # The title of the new score. If the title is too long, the API may trim this one.
    # 
    # If this title is not specified, the API will try to (in this order):
    #   - Use the title contained in the file (e.g. [`movement-title`](https://usermanuals.musicxml.com/MusicXML/Content/EL-MusicXML-movement-title.htm) or [`credit-words`](https://usermanuals.musicxml.com/MusicXML/Content/EL-MusicXML-credit-words.htm) for [MusicXML](http://www.musicxml.com/) files).
    #   - Use the name of the file for files from a specified `source` (e.g. Google Drive) or the one in the `filename` property
    #   - Set a default title (e.g. "New Music Score")
    string title?;
};

# A track synchronization point
public type ScoreTrackPoint record {
    # The measure unique identifier
    string measureUuid?;
    # The corresponding time in seconds
    decimal time;
    # The type of the synchronization point. If the type is `measure`, the measure uuid must be present in `measureUuid`
    "measure"|"end" 'type;
};

public type OmrStepSubmission OmrDetailsSubmission;

# Edit the collection metadata
public type CollectionModification record {
    # The collection main privacy mode.
    # 
    # - `private`: The collection is private and can only be accessed, modified, and administered by specified collaborators
    CollectionPrivacy privacy?;
    # The title of the collection
    @constraint:String {maxLength: 300, minLength: 1}
    string title?;
};

# Represents the Headers record for the operation: getOmrJobExport
public type GetOmrJobExportHeaders record {
    # Preferred locale for localized content in the response (translated error messages, emails, etc.).
    # 
    # Accepts any IETF language tag. The API best-matches the value to a supported locale and never rejects an unknown one (it falls back to the closest match, then to `en`).
    # 
    # Supported normalized locales: `da`, `de`, `en`, `en-GB`, `es`, `fi`, `fil`, `fr`, `fr-CA`, `hi`, `id`, `it`, `ja`, `ko`, `ms`, `nl`, `nb`, `pl`, `pt`, `pt-BR`, `ro`, `ru`, `sv`, `tr`, `zh-Hans`, `zh-HK`, `zh-TW`.
    # 
    # Precedence (highest first): this `X-Flat-Locale` header, the authenticated user's account locale, the `Accept-Language` header, then `en`
    @http:Header {name: "X-Flat-Locale"}
    string xFlatLocale?;
};

# Edit the score metadata
public type ScoreModification record {
    # The type of creation (an original, an arrangement)
    ScoreCreationType? creationType?;
    # License of the creation. Read more about the Creative Commons licenses on https://creativecommons.org/licenses/
    ScoreLicense? license?;
    # The lyricist of the score
    string? lyricist?;
    # The rights info written on the score
    string? licenseText?;
    # The composer of the score
    string? composer?;
    # The subtitle of the score
    string? subtitle?;
    # The score main privacy mode.
    # 
    # - `public`: The score is public on the Internet. This one can be accessible at the url `https://flat.io/score/{score}` and can be modified and administered by specified collaborators users.
    # - `private`: The score is private and can be only accessed, modified and administered by specified collaborators users.
    # - `privateLink`: The score is private but can be accessed using a private link `htmlUrl` or the private key in the property `sharingKey`.
    # - `organizationPublic`: _Available only with [Flat for Education](https://flat.io/edu)._ The score is public in the organization: users of the same organization can access it. The score can be modified and administered by specified collaborators users.
    # 
    # The score can also be individually shared to a set of users or groups using the different collaborators API methods.
    # 
    # When a file is synchronized from an external source (e.g. Google Drive) and the sharing options are changed on the source, Flat will choose the best privacy mode for the file.
    # 
    # When using a [Flat for Education](https://flat.io/edu) account, some of the modes may not be available if disabled by an administrator of the organization (e.g. by default the `public` mode is not available)
    ScorePrivacy privacy?;
    # Description of the creation
    string? description?;
    # The title of the score
    string title?;
    # The arranger of the score
    string? arranger?;
    # When using the `privacy` mode `privateLink`, this property can be used to set a custom sharing key, otherwise a new key will be generated
    @constraint:String {pattern: re `^[a-f0-9]{128}$`}
    string sharingKey?;
    # Tags describing the score
    string[] tags?;
};

# Optional list of specific class group IDs to apply to the assignment.
# When transitioning to active state with group submission mode:
# - If provided: Only these specific groups will be applied
# - If not provided: All class groups will be applied, or randomized groups created if none exist
public type ClassGroupIdsToApplyToAssignment string[]?;

# Public User details summary
public type UserPublicSummary record {
    *UserBasics;
    # User's Organization Role (for Edu users only)
    OrganizationRoles organizationRole?;
    # User's Class Role (for Edu users only)
    ClassRoles classRole?;
    # Organization ID (for Edu users only)
    string organization?;
    # Link to user profile (for Indiv. users only)
    string htmlUrl?;
};

# Creation of an assignment submission comment
public type AssignmentSubmissionCommentCreation record {
    # The comment text
    string comment;
};

# A Microsoft Teams assignment
public type MicrosoftGraphAssignment record {
    # The date when the assignment will become active on Microsoft Teams.
    # 
    # If set to a future date, the assignment will have status `scheduled` and won't be visible to students until this date
    string assignDateTime?;
    # When assignToType is 'individual', array of Microsoft Azure user IDs of students assigned to this assignment.
    # These are the students who can see and submit to this assignment on Teams
    string[] assignedStudentsMsIds?;
    # Recipient configuration for this assignment on Microsoft Teams.
    # 
    # * `class`: Assignment is visible to all students in the class
    # * `individual`: Assignment is visible only to specific assigned students
    "class"|"individual" assignToType?;
    # Absolute link to this assignment in the Microsoft Teams web UI
    string alternateLink?;
    # Identifier of the assignment assigned by Microsoft Teams
    string id?;
    # State of the assignment on Microsoft Teams.
    # 
    # * `draft`: Assignment is in draft mode
    # * `scheduled`: Assignment is scheduled to be published at a future date
    # * `published`: Assignment has been published to students
    # * `assigned`: Assignment has been assigned (legacy status)
    # * `inactive`: Assignment is inactive
    "draft"|"scheduled"|"published"|"assigned"|"inactive" state?;
    # List of categories where this assignment is published under
    string[] categories?;
};

# The contents of the collection
public type CollectionContents record {
    # The number of scores in the collection
    int scoresCount;
};

# The statistics related to the score revision (additions and deletions)
public type ScoreRevisionStatistics record {
    # The number of additions operations in the last revision
    decimal additions?;
    # The number of deletions operations in the last revision
    decimal deletions?;
    # The date of the latest action included in this revision
    string endDate?;
    # The date of the first action included in this revision
    string startDate?;
};

# User details (view for organization teacher / admin)
public type UserDetailsAdmin record {
    *UserPublicSummary;
    # Current active license of the user
    UserDetailsAdmin_license license?;
    # Date of the last user activity
    string lastActivityDate?;
    # Indicates if the user account is marked as a testing student account.
    # Testing students are typically excluded from certain educational integrations and workflows.
    # This field helps API clients distinguish between regular students and testing accounts
    boolean isEduTestingStudent?;
    # For Flat for Education accounts, list of Group identifiers the user is part of
    string[] groups?;
    # Email of the user
    string email?;
};

# Overrides for the `details` step. Omitted fields keep the server's detected values
public type OmrDetailsSubmission record {|
    # Per-part overrides, each matched to a detected part by `index`
    @constraint:Array {maxLength: 200}
    OmrInstrumentOverride[] instruments?;
    # Discriminator for `OmrStepSubmission`; always `details` for this submission
    "details" step;
    # Override the detected work title
    @constraint:String {maxLength: 500}
    string title?;
    # Override the main language (BCP 47) used for lyric and text reading on resume.
    # Defaults to the job locale (`locales`); set this to correct it on the review screen
    @constraint:String {maxLength: 35, minLength: 1}
    string mainLanguage?;
|};

# Represents the Queries record for the operation: listScoreTracks
public type ListScoreTracksQueries record {
    # Only return the tracks related to this assignment
    string assignment?;
    # If `true`, and when available, also return the latest MP3 export automatically generated by Flat as an additional track
    boolean listAutoTrack?;
    # This sharing key must be specified to access to a score or collection with a `privacy` mode set to `privateLink` and the current user is not a collaborator of the document
    string sharingKey?;
};

# Response for track creation including optional upload information
public type ScoreTrackCreationResponse record {
    # An audio track for a score
    ScoreTrack track;
};

# Update of a comment
public type ScoreCommentUpdate record {
    # The context of the comment (for inline/contextualized comments). A context will include all the information related to the location of the comment (i.e. score parts, range of measure, time position)
    ScoreCommentContext context?;
    # The comment text that can include mentions using the following format: `@[id:username]`
    @constraint:String {maxLength: 10000, minLength: 1}
    string comment?;
    # A raw version of the comment, that can be displayed without the mentions. If you use mentions, this property must be set
    @constraint:String {maxLength: 10000, minLength: 1}
    string rawComment?;
    # The unique identifier of the revision of the score where the comment was added. If this property is unspecified or contains "last", the API will automatically take the last revision created
    string revision?;
};

# An API access token
public type ApiAccessToken record {
    # The date when this token was issued
    string issuedDate?;
    # Name of the personal access token
    string name?;
    # Unique identifier of this private token
    string id?;
    # The list of scopes associated to the token
    AppScopes[] scopes?;
    # The token. This token will only be returned once, then only the first 4 characters will be returned
    string token?;
    # The date when this token will expire
    string expirationDate?;
};

# Represents the Headers record for the operation: submitOmrJobStep
public type SubmitOmrJobStepHeaders record {
    # Preferred locale for localized content in the response (translated error messages, emails, etc.).
    # 
    # Accepts any IETF language tag. The API best-matches the value to a supported locale and never rejects an unknown one (it falls back to the closest match, then to `en`).
    # 
    # Supported normalized locales: `da`, `de`, `en`, `en-GB`, `es`, `fi`, `fil`, `fr`, `fr-CA`, `hi`, `id`, `it`, `ja`, `ko`, `ms`, `nl`, `nb`, `pl`, `pt`, `pt-BR`, `ro`, `ru`, `sv`, `tr`, `zh-Hans`, `zh-HK`, `zh-TW`.
    # 
    # Precedence (highest first): this `X-Flat-Locale` header, the authenticated user's account locale, the `Accept-Language` header, then `en`
    @http:Header {name: "X-Flat-Locale"}
    string xFlatLocale?;
};

# Represents the Queries record for the operation: deleteScore
public type DeleteScoreQueries record {
    # If `true`, the score deletion will be scheduled as soon as possible
    boolean now = false;
};

# A Tutteo product.
# 
# * `flat`:       [Flat](https://flat.io) - Music notation software for individual users
# * `flatEdu`:    [Flat for Education](https://flat.io/edu) - Music notation software for schools and educators
# * `msnippet`:   [Music Snippet](https://musicsnippet.com) - Embeddable music snippets for websites
# * `embed`:      [Flat Embed](https://flat.io/developers/embed) - Embeddable music notation editor
public type TutteoProduct "flat"|"flatEdu"|"msnippet"|"embed";

# Assignment Submission creation
public type AssignmentSubmissionUpdate record {
    # Optional grade. If unset, no grade was set. This value is only visible to the teacher, and is copied to `grade` once the teacher returns the submission
    decimal? draftGrade?;
    # The attachments to set on the submission
    ClassAttachmentCreation[] attachments?;
    # If `true`, the submission will be marked as done
    boolean submit?;
    # Optional grade. If unset, no grade was set
    decimal? grade?;
    # The playback statistics of the submission scores
    AssignmentSubmissionPlayback[] playback?;
    # The ids of exercises when they need to be in a specific order
    string[]? exercisesIds?;
    # If `true`, the submission will be returned to the student (teachers only)
    boolean 'return?;
};

# Assignment Resource Editing
public type AssignmentUpdate record {
    # The id of the toolset to apply to this assignment.
    # The toolset will be copied to the assignment as a dedicated object to prevent unexpected changes when making modifications to the template toolset.
    # This property can be set to null to delete the linked toolset and switch back to all the tools available for this assignment
    string? toolset?;
    # The complete attachment list. Omitting this property on an update leaves the existing
    # attachments alone; sending it replaces them.
    # 
    # Dropping a dedicated score from the list deletes the students' copies of it, so send the
    # full set you want to keep rather than only the additions. Duplicates, judged by `url`,
    # `score`, `worksheet` or `googleDriveFileId`, are discarded silently, and exceeding the
    # per-assignment limit fails with `ASSIGNMENT_ATTACHMENTS_LIMIT`
    ClassAttachmentCreation[] attachments?;
    # HTML version of teacher-only instructions.
    # Pasted images may be sent as inline base64 `data:` URIs; they are uploaded to storage
    # and rewritten to hosted URLs on save. The final HTML is limited to 100000 characters.
    # When provided, the plain text version will be automatically extracted for compatibility
    @constraint:String {maxLength: 20000000}
    string teacherInstructionsHtml?;
    # Student instructions and content of the assignment (plain text)
    @constraint:String {maxLength: 100000}
    string description?;
    # Restrict the ability to get an audio feedback every time a student adds or selects a note
    boolean restrictPlayNote?;
    # The id of the cover to display
    string? coverFile?;
    # For worksheets, how grading will work for the assignment:
    # - If set to `auto`, the grades will be automatically released when the student submits the submissions
    # - If set to `manual`, the grades will only be set as `draftGrade` and will be released when the teacher returns the submissions
    "auto"|"manual" releaseGrades?;
    # Type of the assignment
    AssignmentType 'type?;
    # Title of the assignment
    @constraint:String {maxLength: 1000, minLength: 1}
    string title?;
    # Restrict the audio source to provided audio tracks on a score. Students won't be able to use the editor playback
    boolean restrictToAudioTracks?;
    # For performance assignments: "Free Record" mode.
    # 
    # When `true`, no score is attached to the assignment. Students freely record a varied
    # repertoire or an ensemble performance without being constrained by a single score's
    # structure or duration, and all score-dependent options (playback, metronome, backtracking,
    # speed control) are hidden.
    # 
    # Only set when type is 'performance'
    boolean freeRecord?;
    # For performance assignments: Enable students to use the metronome while they are recording,
    # helping them stay in time.
    # Only set when type is 'performance'
    boolean allowMetronome?;
    # The URL of the cover to display
    string? cover?;
    # Teacher-only instructions (plain text)
    @constraint:String {maxLength: 100000}
    string teacherInstructions?;
    # If set, the grading will be enabled for the assignment with this value as the maximum of points
    decimal? maxPoints?;
    # For performance assignments: recording type that will be either 'audio' or 'video'.
    # 
    # * `audio`: Only audio will be required during the recording.
    # * `video`: Camera will be required during the recording.
    # 
    # Only set when type is 'performance'
    "audio"|"video" recordingType?;
    # Submission mode for assignments:
    # - "single": Individual submissions (default)
    # - "group": Group submissions (for shared writing assignments)
    AssignmentSubmissionStudentsMode submissionStudentsMode?;
    # The number of playbacks authorized on the scores of the assignment
    decimal? nbPlaybackAuthorized?;
    # For performance assignments: Enable students to listen to the accompaniment without their
    # instrument part while they are playing.
    # Only set when type is 'performance'
    boolean allowBackingTrack?;
    # HTML version of student instructions.
    # Pasted images may be sent as inline base64 `data:` URIs; they are uploaded to storage
    # and rewritten to hosted URLs on save. The final HTML is limited to 100000 characters.
    # When provided, the plain text version will be automatically extracted for compatibility
    @constraint:String {maxLength: 20000000}
    string descriptionHtml?;
    # Shuffle the worksheet exercises for each student
    boolean shuffleExercises?;
    # For performance assignments: whether students can adjust the playback speed of the score during recording.
    # 
    # * `true`: Students can change the tempo/speed during practice and recording
    # * `false`: Tempo is fixed to the original score tempo
    # 
    # Only set when type is 'performance'
    boolean allowSpeedChange?;
};

# An audio track for a score
public type ScoreTrack record {
    # The synchronization points between the track and the score
    ScoreTrackPoint[] synchronizationPoints?;
    # The unique identifier of the track creator
    string creator;
    # The purpose of the audio track
    ScoreTrackPurpose purpose;
    # Title of the track
    string title?;
    # The creation date of the track
    string creationDate;
    # The type of an audio track
    ScoreTrackType 'type;
    # The unique identifier of the track when hosted on an external service.
    # For example, if the url is `https://www.youtube.com/watch?v=dQw4w9WgXcQ`, `mediaId` will be `dQw4w9WgXcQ`
    string mediaId?;
    # The URL of the track
    string url?;
    # The unique identifier of the score.
    # Absent for Free Record performance submissions, which are recorded without an attached score
    string score?;
    # The modification date of the track
    string modificationDate;
    # True if the track should be used as default audio source
    boolean default;
    # The unique identifier of the score track
    string id;
    # State of the track
    ScoreTrackState state;
};

# A summary of the score details
public type ScoreSummary record {
    # The url where the score can be viewed in a web browser
    string htmlUrl;
    # The score main privacy mode.
    # 
    # - `public`: The score is public on the Internet. This one can be accessible at the url `https://flat.io/score/{score}` and can be modified and administered by specified collaborators users.
    # - `private`: The score is private and can be only accessed, modified and administered by specified collaborators users.
    # - `privateLink`: The score is private but can be accessed using a private link `htmlUrl` or the private key in the property `sharingKey`.
    # - `organizationPublic`: _Available only with [Flat for Education](https://flat.io/edu)._ The score is public in the organization: users of the same organization can access it. The score can be modified and administered by specified collaborators users.
    # 
    # The score can also be individually shared to a set of users or groups using the different collaborators API methods.
    # 
    # When a file is synchronized from an external source (e.g. Google Drive) and the sharing options are changed on the source, Flat will choose the best privacy mode for the file.
    # 
    # When using a [Flat for Education](https://flat.io/edu) account, some of the modes may not be available if disabled by an administrator of the organization (e.g. by default the `public` mode is not available)
    ScorePrivacy privacy;
    # The unique identifier of the score
    string id;
    # The title of the score
    string title;
    # The private sharing key of the score (available when the `privacy` mode is set to `privateLink`)
    string sharingKey?;
    # Public User details
    UserPublic user;
};

# Information about the comment being moderated
public type ScoreCommentModeration record {
    # If the comment is hidden, the reason why this one has been moderated
    "spam"|"inappropriate" reason?;
    # If true, this comment will be hidden from other users
    boolean hidden?;
};

# Detected score details for the client to review before the score is built. `title` and
# `instruments` are detected from the input; the language is not detected and is not part
# of this payload (read the job's `locales`, set at creation)
public type OmrDetailsStepData record {
    # The instruments detected in the scanned pages
    OmrDetectedInstrument[] instruments;
    # Discriminator for `OmrPendingStep.data`; always `details` for this payload
    "details" step;
    # OCR-detected work title
    string title?;
};

public type ScoreCreationBuilderData_builderData_scoreData record {
    # The number of beats in the measure
    decimal nbBeats?;
    # true if the chord grid must be displayed with fretted instruments
    boolean useChordGrid?;
    # The list of instruments to add to the score.
    # See the [Instrument IDs reference](https://flat.io/developers/docs/api/instruments) for the possible values for `group` and `instrument` (also available as the [`@flat/instruments`](https://www.npmjs.com/package/@flat/instruments) package).
    ScoreCreationBuilderData_builderData_scoreData_instruments[] instruments;
    # true if the TAB staff is displayed with fretted instruments
    boolean useTabStaff?;
    # The duration of a beat in the measure
    decimal beatType?;
    # The key signature of the score (expressed between -7 and 7). Major C is used when the value is not provided.
    decimal fifths?;
};

# User creation
public type UserCreation record {
    # First name of the user
    @constraint:String {maxLength: 60}
    string firstname?;
    # Password of the new account
    @constraint:String {maxLength: 1000, minLength: 6}
    string password;
    # Role of the new account
    "user"|"teacher"|"admin"|"accountAdmin" role = "user";
    # User language. Input values will be automatically normalized to a supported locale code
    string locale = "en";
    # Email of the new account
    string email?;
    # Username of the new account
    @constraint:String {maxLength: 30, minLength: 1}
    string username;
    # Last name of the user
    @constraint:String {maxLength: 60}
    string lastname?;
};

