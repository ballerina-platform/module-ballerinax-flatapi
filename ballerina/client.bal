        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }

    # List user's scores
    #
    # + user - Unique identifier of a Flat user. If you authenticated, you can use `me` to refer to the current user
    # + headers - Headers to be sent with the request 
    # + queries - Queries to be sent with the request 
    # + return - The user scores 
    remote isolated function getUserScores(string user, map<string|string[]> headers = {}, *GetUserScoresQueries queries) returns ScoreDetails[]|error {
        string resourcePath = string `/users/${getEncodedUri(user)}/scores`;
        resourcePath = resourcePath + check getPathForQueryParam(queries);
        return self.clientEp->get(resourcePath, headers);
    }
}
